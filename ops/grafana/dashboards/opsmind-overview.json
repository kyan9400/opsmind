          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_resident_memory_bytes, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(process_resident_memory_bytes, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
