    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prometheus-io/client": "^0.16.1",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.17.2",
