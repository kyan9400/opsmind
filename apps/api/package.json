{
  "name": "@opsmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/lib/migrate.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
